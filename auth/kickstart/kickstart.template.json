{
  "variables": {
    "apiKey": "__FUSIONAUTH_API_KEY__",
    "applicationId": "__FUSIONAUTH_APPLICATION_ID__",
    "clientSecret": "__FUSIONAUTH_CLIENT_SECRET__",
    "signingKeyId": "#{UUID()}",
    "defaultTenantId": "__FUSIONAUTH_TENANT_ID__",
    "adminEmail": "__FUSIONAUTH_ADMIN_EMAIL__",
    "adminPassword": "__FUSIONAUTH_ADMIN_PASSWORD__"
  },
  "apiKeys": [
    {
      "key": "#{apiKey}",
      "description": "OSRS Market bootstrap API key"
    }
  ],
  "requests": [
    {
      "method": "PATCH",
      "url": "/api/tenant/#{defaultTenantId}",
      "body": {
        "tenant": {
          "issuer": "__FUSIONAUTH_PUBLIC_URL__",
          "name": "OSRS Market"
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/key/generate/#{signingKeyId}",
      "body": {
        "key": {
          "algorithm": "RS256",
          "name": "OSRS Market development signing key",
          "length": 2048
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/application/#{applicationId}",
      "tenantId": "#{defaultTenantId}",
      "body": {
        "application": {
          "name": "OSRS Market",
          "oauthConfiguration": {
            "authorizedOriginURLs": [
              "__FRONTEND_URL__"
            ],
            "authorizedRedirectURLs": [
              "__FUSIONAUTH_REDIRECT_URI__"
            ],
            "authorizedURLValidationPolicy": "ExactMatch",
            "clientAuthenticationPolicy": "Required",
            "clientSecret": "#{clientSecret}",
            "enabledGrants": [
              "authorization_code",
              "refresh_token"
            ],
            "generateRefreshTokens": true,
            "logoutURL": "__FUSIONAUTH_LOGOUT_URL__",
            "proofKeyForCodeExchangePolicy": "Required",
            "requireRegistration": true,
            "scopeHandlingPolicy": "Strict",
            "unknownScopePolicy": "Reject"
          },
          "jwtConfiguration": {
            "enabled": true,
            "accessTokenKeyId": "#{signingKeyId}",
            "idTokenKeyId": "#{signingKeyId}"
          },
          "registrationConfiguration": {
            "enabled": true,
            "loginIdType": "email"
          },
          "roles": [
            {
              "description": "OSRS Market administrator",
              "isDefault": false,
              "isSuperRole": true,
              "name": "admin"
            }
          ]
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/user/registration",
      "body": {
        "user": {
          "email": "#{adminEmail}",
          "password": "#{adminPassword}"
        },
        "registration": {
          "applicationId": "#{applicationId}",
          "roles": [
            "admin"
          ]
        }
      }
    }
  ]
}