POSTGRES_DB=osrs_market
POSTGRES_USER=osrs_market
POSTGRES_PASSWORD=osrs_market

# FusionAuth
FUSIONAUTH_VERSION=1.69.0

FUSIONAUTH_DATABASE=fusionauth
FUSIONAUTH_DATABASE_USER=fusionauth
FUSIONAUTH_DATABASE_PASSWORD=replace-with-a-strong-database-password

FUSIONAUTH_PUBLIC_URL=https://auth.example.com
FUSIONAUTH_APPLICATION_ID=replace-with-production-application-uuid
FUSIONAUTH_CLIENT_SECRET=replace-with-production-client-secret

FUSIONAUTH_REDIRECT_URI=https://example.com/auth/callback
FRONTEND_URL=https://example.com

AUTH_TOKEN_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters