# Main PostgreSQL database
POSTGRES_DB=osrs_market
POSTGRES_USER=osrs_market
POSTGRES_PASSWORD=replace-with-the-existing-or-production-database-password

# FusionAuth runtime
FUSIONAUTH_VERSION=1.69.0
FUSIONAUTH_PORT=9011
FUSIONAUTH_APP_MEMORY=512M

# FusionAuth database
FUSIONAUTH_DATABASE_NAME=fusionauth
FUSIONAUTH_DATABASE_USER=fusionauth

# Public production URLs
FRONTEND_URL=https://example.com
FUSIONAUTH_PUBLIC_URL=https://fusionauth.example.com
FUSIONAUTH_REDIRECT_URI=https://example.com/auth/callback
FUSIONAUTH_LOGOUT_URL=https://example.com/

# Initial FusionAuth administrator
FUSIONAUTH_ADMIN_EMAIL=admin@example.com

# Production authentication secrets are generated in:
# .secrets/production.env
#
# Generate them with:
# ./scripts/production-auth-secrets.sh